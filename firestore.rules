rules_version = '2';
// Reglas de seguridad de los datos del centro de mando (Legal, Cuentas por pagar, CRM de los ATC).
// La sesión la entrega el puente del ERP (Cloud Function erpLogin): confirma usuario y contraseña en el ERP
// y pone en el token los permisos de /centro_mando ("tableros"). El uid es la key del usuario en el ERP.
service cloud.firestore {
  match /databases/{database}/documents {

    function sesion() {
      return request.auth != null && request.auth.token.cm == 1
        && request.auth.token.vence > request.time.toMillis();
    }
    function permiso(p) { return sesion() && request.auth.token.tableros.hasAny([p]); }
    function yo() { return request.auth.uid; }
    function soloCampos(campos) { return request.resource.data.keys().hasOnly(campos); }
    function texto(c, max) { return !(c in request.resource.data) || request.resource.data[c] == null || (request.resource.data[c] is string && request.resource.data[c].size() <= max); }

    // Lista de sucursales (la lee cualquiera con sesión; la edita Dirección).
    match /config/{doc} {
      allow read: if sesion();
      allow write: if permiso('direccion');
    }

    // ---------- Legal (permiso "legal") ----------
    match /legal_contrato/{id} { allow read, write: if permiso('legal'); }
    match /legal_permiso/{id} { allow read, write: if permiso('legal'); }
    match /legal_caso/{id} { allow read, write: if permiso('legal'); }
    match /legal_caso_evento/{id} { allow read, write: if permiso('legal'); }
    match /legal_plazo/{id} { allow read, write: if permiso('legal'); }

    // ---------- Cuentas por pagar (permiso "administracion") ----------
    match /cxp_cuenta/{id} {
      allow read: if permiso('administracion');
      allow create: if permiso('administracion') && request.resource.data.monto is number && request.resource.data.monto > 0
        && request.resource.data.pagado == 0 && request.resource.data.tipo_costo in ['fijo', 'variable'];
      // Lo pagado nunca supera el monto, y el monto no cambia.
      allow update: if permiso('administracion') && request.resource.data.pagado is number
        && request.resource.data.pagado <= request.resource.data.monto + 0.001 && request.resource.data.monto == resource.data.monto;
      allow delete: if false;
    }
    match /cxp_pago/{id} {
      allow read: if permiso('administracion');
      allow create: if permiso('administracion') && request.resource.data.monto is number && request.resource.data.monto > 0;
      allow update, delete: if false;
    }

    // ---------- CRM: ATC Central (permiso "atencion") y ATC de sucursal (permiso "atc") ----------
    // Jefe de ATC = permiso "jefe_atc". Atención al Cliente (ATC) = permiso "atencion" (o "atc").
    function central() { return permiso('jefe_atc'); }
    function esATC() { return permiso('atencion') || permiso('atc'); }
    function equipoATC() { return central() || esATC(); }
    // Administración y Dirección ven (sin modificar) el trabajo del equipo y las comisiones que se pagan.
    // El muro (pantalla «Ventas ATC») solo lee.
    function veComercial() { return equipoATC() || permiso('administracion') || permiso('direccion') || permiso('muro'); }
    function soyATC() {
      return esATC() && exists(/databases/$(database)/documents/com_ejecutiva/$(yo()))
        && get(/databases/$(database)/documents/com_ejecutiva/$(yo())).data.estado > 0;
    }

    match /com_ejecutiva/{uid} {
      allow read: if veComercial();
      // Un ATC se registra solo la primera vez que entra (sin sucursales ni meta); lo demás lo decide ATC Central.
      allow create: if central() || (esATC() && uid == yo()
        && soloCampos(['nombre', 'key_usuario', 'sucursales', 'meta_mensual', 'estado', 'fecha_on', 'autoregistro'])
        && request.resource.data.key_usuario == yo() && request.resource.data.sucursales.size() == 0
        && request.resource.data.meta_mensual == 0 && request.resource.data.estado == 1 && texto('nombre', 120));
      allow update, delete: if central();
    }
    // Planilla de ATC por sucursal (la usa el Jefe de ATC para ubicar sola a cada ATC nueva).
    match /com_config/{id} {
      // El checklist de módulos por país lo lee cualquier usuario del centro de mando (arma su portal).
      allow read: if veComercial() || ((id == 'modulos_bolivia' || id == 'modulos_paraguay') && sesion());
      // La dirección del puente de cámaras (doc «camaras») también la puede cambiar Dirección.
      allow write: if central() || (id == 'camaras' && permiso('direccion'))
        || ((id == 'modulos_bolivia' || id == 'modulos_paraguay') && permiso('direccion'));
    }
    // Comisiones confirmadas con las ventas del ERP (las escribe el tablero del Jefe de ATC o Administración).
    // Cada ATC lee solo las suyas.
    match /com_comision_conf/{id} {
      allow read: if central() || permiso('administracion') || permiso('direccion') || permiso('muro')
        || (esATC() && resource.data.key_ejecutiva == yo());
      allow create, update: if central() || permiso('administracion');
      allow delete: if false;
    }
    // Paraguay: resumen de ventas por mes (fecha y montos por concepto, sin datos de clientes) para que el
    // tablero de ingresos abra al instante en cualquier equipo. Solo Dirección.
    match /py_ventas/{mes} {
      allow read: if permiso('direccion');
      allow write: if permiso('direccion') && mes.matches('^[0-9]{4}-[0-9]{2}$');
    }
    // Reemplazo de profesores: lo registra Supervisión; lo consultan Dirección, RRHH y Administración. No se borra (se anula).
    match /sup_reemplazo/{id} {
      allow read: if permiso('supervision') || permiso('direccion') || permiso('rrhh') || permiso('administracion');
      allow create: if permiso('supervision') && request.resource.data.registrado_por == yo()
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.titular is string && request.resource.data.titular.size() > 0 && request.resource.data.titular.size() <= 120
        && request.resource.data.reemplazo is string && request.resource.data.reemplazo.size() > 0 && request.resource.data.reemplazo.size() <= 120
        && request.resource.data.clases is int && request.resource.data.clases >= 1 && request.resource.data.clases <= 12
        && request.resource.data.estado == 1;
      allow update: if permiso('supervision') && request.resource.data.registrado_por == resource.data.registrado_por;
      allow delete: if false;
    }
    match /com_asignacion/{cliente} {
      allow read: if veComercial();
      allow write: if central();
    }
    // Campañas con paquete exclusivo: quiénes quedan habilitados para comprarlo (lo arma ATC Central al asignar listas).
    match /com_campana/{id} {
      allow read: if veComercial();
      allow write: if central();
    }
    // Pagos de comisiones (semana de sábado a viernes): los registra el Jefe de ATC o Administración.
    match /com_pago/{id} {
      allow read: if veComercial();
      allow create, update: if (central() || permiso('administracion')) && soloCampos(['key_ejecutiva', 'semana', 'monto', 'ventas', 'estado', 'fecha_on', 'pagado_por'])
        && request.resource.data.monto is number && request.resource.data.monto > 0 && request.resource.data.pagado_por == yo();
      allow delete: if false;
    }
    match /com_guion/{id} {
      allow read: if veComercial();
      allow write: if central();
    }
    match /com_comision_anulada/{id} {
      allow read: if veComercial();
      allow write: if central();
    }
    match /com_tarea/{id} {
      allow read: if veComercial();
      allow create, delete: if central();
      // ATC Central edita todo; un ATC solo marca como hecha una tarea suya o de todo el equipo.
      allow update: if central()
        || (soyATC()
            && (resource.data.key_ejecutiva == null || resource.data.key_ejecutiva == yo())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hecha', 'fecha_hecha', 'comentario_cierre'])
            && request.resource.data.hecha is bool && texto('comentario_cierre', 2000));
    }
    // Seguimiento de clientes activos: lo trabaja solo la Jefa de ATC (Dirección también lo ve y carga mensajes).
    match /com_fid_config/{lista} {
      allow read: if central() || permiso('direccion');
      allow write: if (central() || permiso('direccion'))
        && lista in ['renovar_hoy', 'renovar_semana', 'nunca', 'riesgo']
        && soloCampos(['mensaje', 'promo', 'paquete_key', 'paquete_nombre', 'fecha_edicion', 'key_usuario_edicion', 'editado_por'])
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 1200
        && texto('promo', 300) && texto('paquete_key', 120) && texto('paquete_nombre', 200) && texto('editado_por', 120)
        && request.resource.data.key_usuario_edicion == yo();
    }
    match /com_fid_contacto/{id} {
      allow read: if central() || permiso('direccion');
      allow create: if (central() || permiso('direccion'))
        && soloCampos(['lista', 'key_cliente', 'cliente', 'telefono', 'sucursal', 'paquete_actual', 'fecha_fin', 'canal', 'resultado', 'motivo', 'nota', 'paquete_ofrecido', 'estado', 'fecha_on', 'key_usuario_registro', 'registrado_por'])
        && request.resource.data.lista in ['renovar_hoy', 'renovar_semana', 'nunca', 'riesgo']
        && request.resource.data.resultado in ['renueva', 'lo_piensa', 'no_contesta', 'no_renueva', 'numero_errado']
        && request.resource.data.canal in ['whatsapp', 'llamada', 'presencial', 'otro']
        && (request.resource.data.motivo == null || request.resource.data.motivo in ['horario', 'precio', 'salud', 'viaje_trabajo', 'experiencia', 'se_mudo', 'otro_gimnasio', 'motivacion', 'otro'])
        && request.resource.data.key_cliente is string && request.resource.data.key_cliente.size() > 0 && request.resource.data.key_cliente.size() <= 120
        && texto('cliente', 200) && texto('telefono', 40) && texto('sucursal', 120) && texto('paquete_actual', 200) && texto('nota', 2000)
        && texto('paquete_ofrecido', 200) && texto('registrado_por', 120) && texto('fecha_fin', 10)
        && request.resource.data.fecha_on is string && request.resource.data.estado == 1 && request.resource.data.key_usuario_registro == yo();
      allow update: if central() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
      allow delete: if false;
    }
    // ---------- Mantenimiento: checklist de cada sucursal (carga Mantenimiento, Supervisión o Administración; reciben Administración y Dirección) ----------
    match /mant_config/{id} {
      allow read: if permiso('mantenimiento') || permiso('administracion') || permiso('supervision') || permiso('direccion');
      allow write: if (permiso('administracion') || permiso('direccion')) && id in ['checklist', 'aviso'];
    }
    match /mant_revision/{id} {
      allow read: if permiso('mantenimiento') || permiso('administracion') || permiso('supervision') || permiso('direccion');
      allow create: if (permiso('mantenimiento') || permiso('administracion') || permiso('supervision'))
        && request.resource.data.registrado_por == yo() && request.resource.data.estado == 1
        && request.resource.data.sucursal is string && request.resource.data.sucursal.size() > 0 && request.resource.data.sucursal.size() <= 120
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.items is list && request.resource.data.items.size() <= 300 && texto('observaciones', 2000);
      allow update: if (permiso('administracion') || permiso('direccion')) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'anulado_por', 'fecha_anulacion']);
      allow delete: if false;
    }
    match /mant_falla/{id} {
      allow read: if permiso('mantenimiento') || permiso('administracion') || permiso('supervision') || permiso('direccion');
      allow create: if (permiso('mantenimiento') || permiso('administracion') || permiso('supervision'))
        && request.resource.data.registrado_por == yo() && request.resource.data.estado == 'abierta'
        && request.resource.data.urgencia in ['urgente', 'pronto', 'puede_esperar']
        && texto('sucursal', 120) && texto('area', 60) && texto('item', 120) && texto('nota', 500);
      allow update: if (permiso('mantenimiento') || permiso('administracion') || permiso('supervision') || permiso('direccion'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'nota_resolucion', 'resuelta_por', 'resuelta_nombre', 'fecha_resuelta'])
        && request.resource.data.estado == 'resuelta' && request.resource.data.resuelta_por == yo() && texto('nota_resolucion', 500);
      allow delete: if false;
    }
    // ---------- Calificación de entrenadores: la cargan los supervisores; consultan Dirección, RRHH y Administración ----------
    match /sup_calificacion/{id} {
      allow read: if permiso('supervision') || permiso('direccion') || permiso('rrhh') || permiso('administracion');
      allow create: if permiso('supervision') && request.resource.data.registrado_por == yo() && request.resource.data.estado == 1
        && request.resource.data.entrenador is string && request.resource.data.entrenador.size() > 0 && request.resource.data.entrenador.size() <= 120
        && request.resource.data.sucursal is string && request.resource.data.sucursal.size() > 0 && request.resource.data.sucursal.size() <= 120
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.notas is map && request.resource.data.promedio is number && request.resource.data.promedio >= 1 && request.resource.data.promedio <= 5
        && texto('fortalezas', 1000) && texto('mejorar', 1000) && texto('acuerdo', 1000);
      allow update: if permiso('supervision') && request.resource.data.registrado_por == resource.data.registrado_por;
      allow delete: if false;
    }
    match /com_gestion/{id} {
      allow read: if veComercial();
      // Cada ATC registra contactos solo a su nombre; ATC Central también puede registrar.
      allow create: if (central() || (soyATC() && request.resource.data.key_ejecutiva == yo()))
        && soloCampos(['key_ejecutiva', 'key_cliente', 'cliente', 'sucursal', 'lista', 'canal', 'resultado', 'nota', 'proximo_seguimiento', 'estado', 'fecha_on'])
        && request.resource.data.canal in ['whatsapp', 'llamada', 'presencial', 'otro']
        && request.resource.data.resultado in ['no_contesta', 'interesado', 'agendado', 'no_interesado', 'numero_errado', 'ya_activo', 'otro']
        && request.resource.data.key_cliente is string && request.resource.data.key_cliente.size() <= 120
        && texto('nota', 2000) && texto('cliente', 200) && request.resource.data.fecha_on is string;
      allow update, delete: if central();
    }

    // ---------- Redes sociales (permiso "marketing") ----------
    // Los comentarios de Facebook e Instagram los crea la función metaWebhook; las respuestas las redacta y publica
    // la función (con Claude). Desde el panel solo se aprueba, edita, descarta o pide otra versión.
    function marketing() { return permiso('marketing'); }
    match /rs_config/{pais} {
      allow read: if marketing();
      allow write: if marketing() && pais in ['bolivia', 'paraguay']
        && soloCampos(['datos', 'whatsapp', 'tono_extra', 'auto_activo', 'max_por_hora', 'fecha_mod', 'mod_por'])
        && texto('datos', 12000) && texto('whatsapp', 40) && texto('tono_extra', 2000)
        && request.resource.data.auto_activo is bool
        && request.resource.data.max_por_hora is int && request.resource.data.max_por_hora >= 1 && request.resource.data.max_por_hora <= 300;
      // Identificador público de la app de Meta (para el botón «Conectar con Facebook»).
      allow write: if marketing() && pais == 'meta' && soloCampos(['app_id', 'fecha_mod', 'mod_por'])
        && request.resource.data.app_id is string && request.resource.data.app_id.matches('^[0-9]{5,25}$');
    }
    // Conectar páginas: el panel deja el acceso de corta duración de Facebook; la función lo cambia y lo borra.
    match /rs_vinculo/{id} {
      allow read: if marketing();
      allow create: if marketing() && soloCampos(['user_token', 'pais', 'paginas', 'creado_por', 'fecha', 'estado'])
        && request.resource.data.estado == 'nuevo' && request.resource.data.creado_por == yo()
        && request.resource.data.pais in ['bolivia', 'paraguay']
        && request.resource.data.user_token is string && request.resource.data.user_token.size() > 20 && request.resource.data.user_token.size() < 2000;
      allow update, delete: if false;
    }
    // CRM de mensajes directos: el personal cambia estado, asignación, nota, bot y tema; los mensajes los crea la función.
    match /rs_conversacion/{id} {
      allow read: if marketing();
      allow update: if marketing()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado_atencion', 'asignado_a', 'asignado_nombre', 'nota', 'bot', 'no_leidos', 'tema', 'fecha_mod', 'mod_por'])
        && request.resource.data.estado_atencion in ['por_atender', 'en_curso', 'atendido', 'no_requiere', 'bot']
        && request.resource.data.bot in ['activo', 'pausado'] && request.resource.data.mod_por == yo()
        && texto('nota', 2000) && texto('asignado_nombre', 120)
        && (request.resource.data.asignado_a == null || request.resource.data.asignado_a is string);
      allow create, delete: if false;
    }
    match /rs_mensaje/{id} {
      allow read: if marketing();
      // El personal responde desde el panel: queda «pendiente» y la función lo envía.
      allow create: if marketing() && soloCampos(['conversacion', 'de', 'texto', 'fecha', 'autor', 'autor_nombre', 'estado_envio'])
        && request.resource.data.de == 'personal' && request.resource.data.estado_envio == 'pendiente' && request.resource.data.autor == yo()
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1000
        && exists(/databases/$(database)/documents/rs_conversacion/$(request.resource.data.conversacion)) && texto('autor_nombre', 120);
      allow update, delete: if false;
    }
    match /rs_cuenta/{id} {
      allow read: if marketing();
      allow write: if marketing() && id.matches('^[0-9]{5,25}$')
        && soloCampos(['plataforma', 'pais', 'nombre', 'activa', 'auto', 'fecha_mod', 'mod_por'])
        && request.resource.data.plataforma in ['facebook', 'instagram'] && request.resource.data.pais in ['bolivia', 'paraguay']
        && request.resource.data.activa is bool && request.resource.data.auto is bool && texto('nombre', 120);
    }
    // El token de la página se puede cargar o reemplazar, pero nunca leer desde el navegador.
    match /rs_token/{id} {
      allow read: if false;
      allow create, update: if marketing() && id.matches('^[0-9]{5,25}$') && soloCampos(['token', 'fecha_mod', 'mod_por'])
        && request.resource.data.token is string && request.resource.data.token.size() >= 20 && request.resource.data.token.size() <= 1000;
      allow delete: if marketing();
    }
    match /rs_comentario/{id} {
      allow read: if marketing();
      // TikTok: el panel pega el comentario y la función devuelve el borrador.
      allow create: if marketing() && request.resource.data.plataforma == 'tiktok' && request.resource.data.estado == 'nuevo'
        && soloCampos(['plataforma', 'pais', 'texto', 'autor', 'publicacion_texto', 'estado', 'fecha_on', 'creado_por', 'id', 'cuenta'])
        && request.resource.data.pais in ['bolivia', 'paraguay'] && request.resource.data.creado_por == yo()
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 4000
        && texto('autor', 80) && texto('publicacion_texto', 1500);
      // Aprobar, editar, descartar o pedir otra versión. Nada más.
      allow update: if marketing()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respuesta_final', 'revisado_por', 'fecha_revision', 'indicacion'])
        && request.resource.data.revisado_por == yo() && texto('respuesta_final', 1000) && texto('indicacion', 300)
        && (
          (resource.data.plataforma != 'tiktok' && resource.data.estado in ['pendiente', 'error']
            && request.resource.data.estado in ['pendiente', 'error', 'aprobado', 'descartado', 'regenerar'])
          || (resource.data.plataforma == 'tiktok' && resource.data.estado == 'borrador'
            && request.resource.data.estado in ['borrador', 'publicado_manual', 'descartado', 'regenerar'])
        );
      allow delete: if false;
    }

    // ---------- Códigos de referido: sesión de cualquier usuario del ERP ----------
    function refSesion() { return request.auth != null && request.auth.token.ref == 1 && request.auth.token.vence > request.time.toMillis(); }
    function refAdmin() { return permiso('direccion') || permiso('administracion'); }
    function refAdminPY() { return permisoPY('direccion') || permisoPY('administracion'); }

    // ---------- Códigos de referido · Bolivia (colecciones ref_*) ----------
    // Cualquier usuario del ERP (token.ref) ve solo lo suyo; Dirección y Administración configuran, sincronizan con el ERP
    // y liquidan. El cliente se anota sin sesión desde el link/QR: solo puede CREAR su inscripción (no leer nada).
    match /ref_config/{d} { allow read: if refSesion(); allow write: if refAdmin(); }
    match /ref_codigo_idx/{codigo} {
      allow read: if true;   // la página pública muestra a quién pertenece el código (solo el primer nombre)
      allow create: if refSesion() && request.resource.data.key_usuario == yo() && codigo.matches('^[A-Z0-9]{1,14}-CAL$')
        && soloCampos(['key_usuario', 'nombre', 'estado', 'fecha_on']) && texto('nombre', 40);
      allow update, delete: if refAdmin();
    }
    match /ref_codigo/{uid} {
      allow read: if (refSesion() && uid == yo()) || refAdmin();
      allow create: if refSesion() && uid == yo() && request.resource.data.key_usuario == yo() && request.resource.data.estado == 1
        && soloCampos(['codigo', 'key_usuario', 'nombre', 'ci', 'telefono', 'familiares', 'estado', 'fecha_on'])
        && texto('ci', 20) && texto('telefono', 20) && texto('nombre', 120) && request.resource.data.familiares is list && request.resource.data.familiares.size() <= 30;
      // El trabajador solo puede actualizar su celular y sus familiares (el código y el carnet no cambian).
      allow update: if (refSesion() && uid == yo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['telefono', 'familiares', 'fecha_edicion'])
        && request.resource.data.familiares is list && request.resource.data.familiares.size() <= 30) || refAdmin();
      allow delete: if false;
    }
    match /ref_inscripcion/{id} {
      allow create: if soloCampos(['codigo', 'ci', 'telefono', 'nombre', 'fecha_on', 'estado'])
        && request.resource.data.estado == 'nueva' && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 20
        && request.resource.data.ci is string && request.resource.data.ci.size() <= 20 && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 20
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 80
        && request.resource.data.fecha_on is string && request.resource.data.fecha_on.size() <= 30;
      allow read, update: if refAdmin();
      allow delete: if false;
    }
    match /ref_cliente/{id} { allow read, write: if refAdmin(); }
    match /ref_alerta/{id} { allow read, write: if refAdmin(); }
    match /ref_comision/{id} {
      allow read: if refAdmin() || (refSesion() && resource.data.key_trabajador == yo());
      allow create, update: if refAdmin();
      allow delete: if false;
    }
    match /ref_liquidacion/{id} {
      allow read: if refAdmin() || (refSesion() && resource.data.key_trabajador == yo());
      allow create: if refAdmin() && request.resource.data.neto is number && request.resource.data.neto > 0 && request.resource.data.pagado_por == yo();
      allow update, delete: if false;
    }
    match /ref_resumen/{periodo} { allow read: if refSesion(); allow write: if refAdmin(); }

    // ---------- Códigos de referido · Paraguay (colecciones py_ref_*) ----------
    // Cualquier usuario del ERP (token.ref) ve solo lo suyo; Dirección y Administración configuran, sincronizan con el ERP
    // y liquidan. El cliente se anota sin sesión desde el link/QR: solo puede CREAR su inscripción (no leer nada).
    match /py_ref_config/{d} { allow read: if refSesion(); allow write: if refAdminPY(); }
    match /py_ref_codigo_idx/{codigo} {
      allow read: if true;   // la página pública muestra a quién pertenece el código (solo el primer nombre)
      allow create: if refSesion() && request.resource.data.key_usuario == yo() && codigo.matches('^[A-Z0-9]{1,14}-CAL$')
        && soloCampos(['key_usuario', 'nombre', 'estado', 'fecha_on']) && texto('nombre', 40);
      allow update, delete: if refAdminPY();
    }
    match /py_ref_codigo/{uid} {
      allow read: if (refSesion() && uid == yo()) || refAdminPY();
      allow create: if refSesion() && uid == yo() && request.resource.data.key_usuario == yo() && request.resource.data.estado == 1
        && soloCampos(['codigo', 'key_usuario', 'nombre', 'ci', 'telefono', 'familiares', 'estado', 'fecha_on'])
        && texto('ci', 20) && texto('telefono', 20) && texto('nombre', 120) && request.resource.data.familiares is list && request.resource.data.familiares.size() <= 30;
      // El trabajador solo puede actualizar su celular y sus familiares (el código y el carnet no cambian).
      allow update: if (refSesion() && uid == yo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['telefono', 'familiares', 'fecha_edicion'])
        && request.resource.data.familiares is list && request.resource.data.familiares.size() <= 30) || refAdminPY();
      allow delete: if false;
    }
    match /py_ref_inscripcion/{id} {
      allow create: if soloCampos(['codigo', 'ci', 'telefono', 'nombre', 'fecha_on', 'estado'])
        && request.resource.data.estado == 'nueva' && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 20
        && request.resource.data.ci is string && request.resource.data.ci.size() <= 20 && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 20
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 80
        && request.resource.data.fecha_on is string && request.resource.data.fecha_on.size() <= 30;
      allow read, update: if refAdminPY();
      allow delete: if false;
    }
    match /py_ref_cliente/{id} { allow read, write: if refAdminPY(); }
    match /py_ref_alerta/{id} { allow read, write: if refAdminPY(); }
    match /py_ref_comision/{id} {
      allow read: if refAdminPY() || (refSesion() && resource.data.key_trabajador == yo());
      allow create, update: if refAdminPY();
      allow delete: if false;
    }
    match /py_ref_liquidacion/{id} {
      allow read: if refAdminPY() || (refSesion() && resource.data.key_trabajador == yo());
      allow create: if refAdminPY() && request.resource.data.neto is number && request.resource.data.neto > 0 && request.resource.data.pagado_por == yo();
      allow update, delete: if false;
    }
    match /py_ref_resumen/{periodo} { allow read: if refSesion(); allow write: if refAdminPY(); }

    // ---------- Cámaras: espejo de SmartPSS de la oficina ----------
    // Escribe solo el usuario propio de la PC de la oficina (Firebase Auth con correo y clave, guardados solo en esa PC).
    // Lo ven el muro, Dirección, Jefe de ATC y Supervisión.
    match /cam_espejo/{lugar} {
      allow read: if permiso('muro') || permiso('direccion') || permiso('jefe_atc') || permiso('supervision');
      allow write: if request.auth != null && request.auth.token.email == 'camaras-oficina@centro-de-mando.calistenia'
        && request.auth.token.firebase.sign_in_provider == 'password' && lugar.matches('^[a-z0-9_-]{1,30}$')
        && request.resource.data.keys().hasOnly(['img', 'fecha', 'ancho', 'alto', 'pc', 'cada'])
        && request.resource.data.img is string && request.resource.data.img.size() < 1000000;
    }

    // Todo lo demás (incluida la antigua colección "roles"), cerrado.
    match /{documento=**} { allow read, write: if false; }

    // ---------- CRM de Paraguay: el mismo sistema que Bolivia, con sus propias colecciones (py_com_*) ----------
    // Generado a partir de las reglas de Bolivia: mismos controles, con los permisos de /centro_mando del ERP de Paraguay
    // (token.tableros_py). Dirección de Bolivia tiene acceso a todo en Paraguay.
    function permisoPY(p) {
      return sesion() && (('tableros_py' in request.auth.token && request.auth.token.tableros_py.hasAny([p]))
        || request.auth.token.tableros.hasAny(['direccion']));
    }
    function centralPY() { return permisoPY('jefe_atc'); }
    function esATCPY() { return permisoPY('atencion') || permisoPY('atc'); }
    function equipoATCPY() { return centralPY() || esATCPY(); }
    function veComercialPY() { return equipoATCPY() || permisoPY('administracion') || permisoPY('direccion') || permisoPY('muro'); }
    function soyATCPY() {
      return esATCPY() && exists(/databases/$(database)/documents/py_com_ejecutiva/$(yo()))
        && get(/databases/$(database)/documents/py_com_ejecutiva/$(yo())).data.estado > 0;
    }
    match /py_com_config/{id} {
      allow read: if veComercialPY();
      allow write: if centralPY();
    }
    match /py_com_ejecutiva/{uid} {
      allow read: if veComercialPY();
      // Un ATC se registra solo la primera vez que entra (sin sucursales ni meta); lo demás lo decide ATC Central.
      allow create: if centralPY() || (esATCPY() && uid == yo()
        && soloCampos(['nombre', 'key_usuario', 'sucursales', 'meta_mensual', 'estado', 'fecha_on', 'autoregistro'])
        && request.resource.data.key_usuario == yo() && request.resource.data.sucursales.size() == 0
        && request.resource.data.meta_mensual == 0 && request.resource.data.estado == 1 && texto('nombre', 120));
      allow update, delete: if centralPY();
    }
    match /py_com_comision_conf/{id} {
      allow read: if centralPY() || permisoPY('administracion') || permisoPY('direccion') || permisoPY('muro')
        || (esATCPY() && resource.data.key_ejecutiva == yo());
      allow create, update: if centralPY() || permisoPY('administracion');
      allow delete: if false;
    }
    match /py_com_asignacion/{cliente} {
      allow read: if veComercialPY();
      allow write: if centralPY();
    }
    match /py_com_campana/{id} {
      allow read: if veComercialPY();
      allow write: if centralPY();
    }
    match /py_com_pago/{id} {
      allow read: if veComercialPY();
      allow create, update: if (centralPY() || permisoPY('administracion')) && soloCampos(['key_ejecutiva', 'semana', 'monto', 'ventas', 'estado', 'fecha_on', 'pagado_por'])
        && request.resource.data.monto is number && request.resource.data.monto > 0 && request.resource.data.pagado_por == yo();
      allow delete: if false;
    }
    match /py_com_guion/{id} {
      allow read: if veComercialPY();
      allow write: if centralPY();
    }
    match /py_com_comision_anulada/{id} {
      allow read: if veComercialPY();
      allow write: if centralPY();
    }
    match /py_com_tarea/{id} {
      allow read: if veComercialPY();
      allow create, delete: if centralPY();
      // ATC Central edita todo; un ATC solo marca como hecha una tarea suya o de todo el equipo.
      allow update: if centralPY()
        || (soyATCPY()
            && (resource.data.key_ejecutiva == null || resource.data.key_ejecutiva == yo())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hecha', 'fecha_hecha', 'comentario_cierre'])
            && request.resource.data.hecha is bool && texto('comentario_cierre', 2000));
    }
    // Seguimiento de clientes activos: lo trabaja solo la Jefa de ATC (Dirección también lo ve y carga mensajes).
    match /py_com_fid_config/{lista} {
      allow read: if centralPY() || permisoPY('direccion');
      allow write: if (centralPY() || permisoPY('direccion'))
        && lista in ['renovar_hoy', 'renovar_semana', 'nunca', 'riesgo']
        && soloCampos(['mensaje', 'promo', 'paquete_key', 'paquete_nombre', 'fecha_edicion', 'key_usuario_edicion', 'editado_por'])
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 1200
        && texto('promo', 300) && texto('paquete_key', 120) && texto('paquete_nombre', 200) && texto('editado_por', 120)
        && request.resource.data.key_usuario_edicion == yo();
    }
    match /py_com_fid_contacto/{id} {
      allow read: if centralPY() || permisoPY('direccion');
      allow create: if (centralPY() || permisoPY('direccion'))
        && soloCampos(['lista', 'key_cliente', 'cliente', 'telefono', 'sucursal', 'paquete_actual', 'fecha_fin', 'canal', 'resultado', 'motivo', 'nota', 'paquete_ofrecido', 'estado', 'fecha_on', 'key_usuario_registro', 'registrado_por'])
        && request.resource.data.lista in ['renovar_hoy', 'renovar_semana', 'nunca', 'riesgo']
        && request.resource.data.resultado in ['renueva', 'lo_piensa', 'no_contesta', 'no_renueva', 'numero_errado']
        && request.resource.data.canal in ['whatsapp', 'llamada', 'presencial', 'otro']
        && (request.resource.data.motivo == null || request.resource.data.motivo in ['horario', 'precio', 'salud', 'viaje_trabajo', 'experiencia', 'se_mudo', 'otro_gimnasio', 'motivacion', 'otro'])
        && request.resource.data.key_cliente is string && request.resource.data.key_cliente.size() > 0 && request.resource.data.key_cliente.size() <= 120
        && texto('cliente', 200) && texto('telefono', 40) && texto('sucursal', 120) && texto('paquete_actual', 200) && texto('nota', 2000)
        && texto('paquete_ofrecido', 200) && texto('registrado_por', 120) && texto('fecha_fin', 10)
        && request.resource.data.fecha_on is string && request.resource.data.estado == 1 && request.resource.data.key_usuario_registro == yo();
      allow update: if centralPY() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
      allow delete: if false;
    }
    // ---------- Mantenimiento: checklist de cada sucursal (carga Mantenimiento, Supervisión o Administración; reciben Administración y Dirección) ----------
    match /py_mant_config/{id} {
      allow read: if permisoPY('mantenimiento') || permisoPY('administracion') || permisoPY('supervision') || permisoPY('direccion');
      allow write: if (permisoPY('administracion') || permisoPY('direccion')) && id in ['checklist', 'aviso'];
    }
    match /py_mant_revision/{id} {
      allow read: if permisoPY('mantenimiento') || permisoPY('administracion') || permisoPY('supervision') || permisoPY('direccion');
      allow create: if (permisoPY('mantenimiento') || permisoPY('administracion') || permisoPY('supervision'))
        && request.resource.data.registrado_por == yo() && request.resource.data.estado == 1
        && request.resource.data.sucursal is string && request.resource.data.sucursal.size() > 0 && request.resource.data.sucursal.size() <= 120
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.items is list && request.resource.data.items.size() <= 300 && texto('observaciones', 2000);
      allow update: if (permisoPY('administracion') || permisoPY('direccion')) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'anulado_por', 'fecha_anulacion']);
      allow delete: if false;
    }
    match /py_mant_falla/{id} {
      allow read: if permisoPY('mantenimiento') || permisoPY('administracion') || permisoPY('supervision') || permisoPY('direccion');
      allow create: if (permisoPY('mantenimiento') || permisoPY('administracion') || permisoPY('supervision'))
        && request.resource.data.registrado_por == yo() && request.resource.data.estado == 'abierta'
        && request.resource.data.urgencia in ['urgente', 'pronto', 'puede_esperar']
        && texto('sucursal', 120) && texto('area', 60) && texto('item', 120) && texto('nota', 500);
      allow update: if (permisoPY('mantenimiento') || permisoPY('administracion') || permisoPY('supervision') || permisoPY('direccion'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'nota_resolucion', 'resuelta_por', 'resuelta_nombre', 'fecha_resuelta'])
        && request.resource.data.estado == 'resuelta' && request.resource.data.resuelta_por == yo() && texto('nota_resolucion', 500);
      allow delete: if false;
    }
    // ---------- Calificación de entrenadores: la cargan los supervisores; consultan Dirección, RRHH y Administración ----------
    match /py_sup_calificacion/{id} {
      allow read: if permisoPY('supervision') || permisoPY('direccion') || permisoPY('rrhh') || permisoPY('administracion');
      allow create: if permisoPY('supervision') && request.resource.data.registrado_por == yo() && request.resource.data.estado == 1
        && request.resource.data.entrenador is string && request.resource.data.entrenador.size() > 0 && request.resource.data.entrenador.size() <= 120
        && request.resource.data.sucursal is string && request.resource.data.sucursal.size() > 0 && request.resource.data.sucursal.size() <= 120
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.notas is map && request.resource.data.promedio is number && request.resource.data.promedio >= 1 && request.resource.data.promedio <= 5
        && texto('fortalezas', 1000) && texto('mejorar', 1000) && texto('acuerdo', 1000);
      allow update: if permisoPY('supervision') && request.resource.data.registrado_por == resource.data.registrado_por;
      allow delete: if false;
    }
    match /py_com_gestion/{id} {
      allow read: if veComercialPY();
      // Cada ATC registra contactos solo a su nombre; ATC Central también puede registrar.
      allow create: if (centralPY() || (soyATCPY() && request.resource.data.key_ejecutiva == yo()))
        && soloCampos(['key_ejecutiva', 'key_cliente', 'cliente', 'sucursal', 'lista', 'canal', 'resultado', 'nota', 'proximo_seguimiento', 'estado', 'fecha_on'])
        && request.resource.data.canal in ['whatsapp', 'llamada', 'presencial', 'otro']
        && request.resource.data.resultado in ['no_contesta', 'interesado', 'agendado', 'no_interesado', 'numero_errado', 'ya_activo', 'otro']
        && request.resource.data.key_cliente is string && request.resource.data.key_cliente.size() <= 120
        && texto('nota', 2000) && texto('cliente', 200) && request.resource.data.fecha_on is string;
      allow update, delete: if centralPY();
    }
  }
}
