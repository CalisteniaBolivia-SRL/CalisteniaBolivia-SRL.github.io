rules_version = '2';
// Reglas de seguridad de los datos del centro de mando (Legal, Cuentas por pagar, CRM de los ATC).
// La sesión la entrega el puente del ERP (Cloud Function erpLogin): confirma usuario y contraseña en el ERP
// y pone en el token los permisos de /centro_mando ("tableros"). El uid es la key del usuario en el ERP.
service cloud.firestore {
  match /databases/{database}/documents {

    function sesion() {
      return request.auth != null && request.auth.token.cm == 1
        && request.auth.token.vence > request.time.toMillis();
    }
    function permiso(p) { return sesion() && request.auth.token.tableros.hasAny([p]); }
    function yo() { return request.auth.uid; }
    function soloCampos(campos) { return request.resource.data.keys().hasOnly(campos); }
    function texto(c, max) { return !(c in request.resource.data) || request.resource.data[c] == null || (request.resource.data[c] is string && request.resource.data[c].size() <= max); }

    // Lista de sucursales (la lee cualquiera con sesión; la edita Dirección).
    match /config/{doc} {
      allow read: if sesion();
      allow write: if permiso('direccion');
    }

    // ---------- Legal (permiso "legal") ----------
    match /legal_contrato/{id} { allow read, write: if permiso('legal'); }
    match /legal_permiso/{id} { allow read, write: if permiso('legal'); }
    match /legal_caso/{id} { allow read, write: if permiso('legal'); }
    match /legal_caso_evento/{id} { allow read, write: if permiso('legal'); }
    match /legal_plazo/{id} { allow read, write: if permiso('legal'); }

    // ---------- Cuentas por pagar (permiso "administracion") ----------
    match /cxp_cuenta/{id} {
      allow read: if permiso('administracion');
      allow create: if permiso('administracion') && request.resource.data.monto is number && request.resource.data.monto > 0
        && request.resource.data.pagado == 0 && request.resource.data.tipo_costo in ['fijo', 'variable'];
      // Lo pagado nunca supera el monto, y el monto no cambia.
      allow update: if permiso('administracion') && request.resource.data.pagado is number
        && request.resource.data.pagado <= request.resource.data.monto + 0.001 && request.resource.data.monto == resource.data.monto;
      allow delete: if false;
    }
    match /cxp_pago/{id} {
      allow read: if permiso('administracion');
      allow create: if permiso('administracion') && request.resource.data.monto is number && request.resource.data.monto > 0;
      allow update, delete: if false;
    }

    // ---------- CRM: ATC Central (permiso "atencion") y ATC de sucursal (permiso "atc") ----------
    function central() { return permiso('atencion'); }
    function equipoATC() { return permiso('atencion') || permiso('atc'); }
    function soyATC() {
      return permiso('atc') && exists(/databases/$(database)/documents/com_ejecutiva/$(yo()))
        && get(/databases/$(database)/documents/com_ejecutiva/$(yo())).data.estado > 0;
    }

    match /com_ejecutiva/{uid} {
      allow read: if equipoATC();
      // Un ATC se registra solo la primera vez que entra (sin sucursales ni meta); lo demás lo decide ATC Central.
      allow create: if central() || (permiso('atc') && uid == yo()
        && soloCampos(['nombre', 'key_usuario', 'sucursales', 'meta_mensual', 'estado', 'fecha_on', 'autoregistro'])
        && request.resource.data.key_usuario == yo() && request.resource.data.sucursales.size() == 0
        && request.resource.data.meta_mensual == 0 && request.resource.data.estado == 1 && texto('nombre', 120));
      allow update, delete: if central();
    }
    match /com_asignacion/{cliente} {
      allow read: if equipoATC();
      allow write: if central();
    }
    match /com_guion/{id} {
      allow read: if equipoATC();
      allow write: if central();
    }
    match /com_comision_anulada/{id} {
      allow read: if equipoATC();
      allow write: if central();
    }
    match /com_tarea/{id} {
      allow read: if equipoATC();
      allow create, delete: if central();
      // ATC Central edita todo; un ATC solo marca como hecha una tarea suya o de todo el equipo.
      allow update: if central()
        || (soyATC()
            && (resource.data.key_ejecutiva == null || resource.data.key_ejecutiva == yo())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hecha', 'fecha_hecha', 'comentario_cierre'])
            && request.resource.data.hecha is bool && texto('comentario_cierre', 2000));
    }
    match /com_gestion/{id} {
      allow read: if equipoATC();
      // Cada ATC registra contactos solo a su nombre; ATC Central también puede registrar.
      allow create: if (central() || (soyATC() && request.resource.data.key_ejecutiva == yo()))
        && soloCampos(['key_ejecutiva', 'key_cliente', 'cliente', 'sucursal', 'lista', 'canal', 'resultado', 'nota', 'proximo_seguimiento', 'estado', 'fecha_on'])
        && request.resource.data.canal in ['whatsapp', 'llamada', 'presencial', 'otro']
        && request.resource.data.resultado in ['no_contesta', 'interesado', 'agendado', 'no_interesado', 'numero_errado', 'otro']
        && request.resource.data.key_cliente is string && request.resource.data.key_cliente.size() <= 120
        && texto('nota', 2000) && texto('cliente', 200) && request.resource.data.fecha_on is string;
      allow update, delete: if central();
    }

    // Todo lo demás (incluida la antigua colección "roles"), cerrado.
    match /{documento=**} { allow read, write: if false; }
  }
}
